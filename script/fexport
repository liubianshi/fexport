#!/usr/bin/env perl
# vim: set ft=perl nowrap fdm=marker

use v5.20;
use strict;
use warnings;
use utf8;
use Encode qw(decode_utf8);

# 统一处理全局 I/O 编码 (STDIN/OUT/ERR) 与输入参数解码
use open qw(:std :utf8);
@ARGV = map { decode_utf8($_) } @ARGV;

use FindBin;
use lib "$FindBin::RealBin/../lib/perl5", "$FindBin::RealBin/../lib";

# --- Core Dependencies ---
use Path::Tiny;
use Getopt::Long     qw(:config bundling);
use List::Util       qw(any);
use Cwd              qw(getcwd abs_path);
use POSIX            qw(setsid);
use Text::ParseWords qw(shellwords);

use Term::ANSIColor qw(:constants);
$Term::ANSIColor::AUTORESET = 1;

# --- Fexport Modules ---
use Fexport::Config      qw(load_config merge_config process_params);
use Fexport::Util        qw(run_pandoc save_lines stop_browser_preview);
use Fexport::PostProcess qw(postprocess_docx postprocess_html postprocess_latex);
use Fexport::Rmd         qw(render_rmd);
use Fexport::Quarto      qw(render_qmd);
use Fexport::Pandoc      qw(build_cmd);
use Fexport::Converter   qw(convert);

# --- Global Cleanup Handling ---
my @temp_files;
$SIG{INT} = $SIG{TERM} = sub {
  path($_)->remove for @temp_files;
  exit 1;
};

# ==============================================================================
# 1. 参数解析与配置合并
# ==============================================================================

my %cli;
my @passthrough_args;

# Locate the '--' separator using grep (idiomatic Perl approach)
my ($sep_index) = grep { $ARGV[$_] eq '--' } 0 .. $#ARGV;

if ( defined $sep_index ) {
  @passthrough_args = splice( @ARGV, $sep_index + 1 );
  pop @ARGV;    # Remove the '--' itself
}

# Define command-line options
GetOptions(
  \%cli,
  'config|c=s',
  'to|t=s',
  'from|f=s',
  'outfile|o=s',
  'outdir|d=s',
  'workdir|w=s',
  'verbose|v',
  'keep|k',
  'preview|p',
  'stop-preview',
  'help|h',
  'browser|b=s',
) or pod2usage(2);

# Handle help or stop-preview early
if ( $cli{help} ) {
  require Pod::Usage;
  Pod::Usage::pod2usage(0);
}

if ( $cli{'stop-preview'} ) {
  stop_browser_preview();
  exit 0;
}

# 加载并合并配置
my $file_config = load_config( $cli{config} );
$cli{pandoc_opts} = \@passthrough_args;

my $opts = merge_config( $file_config, \%cli );

# 路径解析
my $infile_raw = $ARGV[0];
my $cwd_raw    = decode_utf8( getcwd() );
my ( $work_dir_str, $infile_str, $outfile_str ) = process_params( $opts, $infile_raw, $cwd_raw );

my $workdir = path($work_dir_str);
my $outfile = path($outfile_str);
my $infile  = defined $infile_str ? path($infile_str) : undef;

if ( $workdir->stringify ne path(".")->absolute->stringify ) {
  chdir $workdir;
}

# ==============================================================================
# 2. 执行转换
# ==============================================================================
my @pandoc_cmd = build_cmd(
  $opts->{pandoc},
  {
    from        => $opts->{from},
    verbose     => $opts->{verbose},
    user_opts   => $opts->{pandoc_opts},
    format_opts => $opts->{format_opts},
  }
);

my $log_file = Path::Tiny->tempfile;
my $log_fh   = $log_file->openw;

my @md_lines;
if ( $opts->{from} eq 'md' ) {
  if ($infile) {
    @md_lines = $infile->lines_utf8;
  }
  else {
    @md_lines = <STDIN>;
  }
}
elsif ( $opts->{from} eq 'rmd' ) {
  unless ($infile) {
    my $tmp = Path::Tiny->tempfile( SUFFIX => '.Rmd' );
    $tmp->spew_utf8( join( "", <STDIN> ) );
    $infile = $tmp;
  }
  render_rmd( $infile, $outfile, $opts->{verbose} );
  exit 0;
}
elsif ( $opts->{from} eq 'qmd' ) {
  render_qmd( $infile, $outfile, $opts->{verbose} );
  exit 0;
}

convert(
  {
    format      => $opts->{to},
    pandoc      => \@pandoc_cmd,
    outfile     => $outfile,
    md_contents => \@md_lines,
    log_fh      => $log_fh,
    verbose     => $opts->{verbose},
    keep        => $opts->{keep},
    preview     => $opts->{preview},
    browser     => $opts->{browser},
  }
);

1;

__END__

=head1 NAME

fexport - 通用文档转换导出工具

=head1 SYNOPSIS

fexport [options] [input_file] [-- pandoc_options]

=head1 OPTIONS

=over 4

=item B<-c, --config FILE>

指定配置文件路径 (默认查找 ~/.config/fexport/config.yaml 或 ~/.fexport.yaml)

=item B<-t, --to FORMAT>

输出格式: html, pdf, docx, pptx, tex (默认: html)

=item B<-f, --from FORMAT>

输入格式: md, rmd, qmd (默认根据后缀自动推断)

=item B<-o, --outfile FILE>

指定输出文件名

=item B<-d, --outdir DIR>

指定输出目录

=item B<-w, --workdir DIR>

手动指定工作目录 (处理资源引用)

=item B<-v, --verbose>

显示详细执行过程和 Pandoc 调试信息

=item B<-k, --keep>

保留中间过程文件 (如 PDF 转换时的 .tex 文件)

=item B<-p, --preview>

转换后自动在浏览器预览 (仅支持 HTML)

=item B<-b, --browser CMD>

预览时使用的浏览器命令

=item B<--stop-preview>

停止所有后台运行的预览服务器

=back

=head1 DESCRIPTION

fexport 是一个封装了 Pandoc, RMarkdown (knitr) 和 Quarto 的转换工具，旨在提供统一的导出体验和预设配置。

使用：C<fexport -c ~/.fexport.yaml input.md>

=head1 FILES

=over 4

=item F<~/.config/fexport/config.yaml>

用户配置文件 (XDG 规范位置)

=item F<~/.fexport.yaml>

用户配置文件 (向后兼容位置)

=item F<lib/Fexport/Defaults.pm>

内置默认配置文件

=item F</tmp/fexport-state/>

预览服务器状态目录

=back

=head1 SEE ALSO

L<pandoc(1)>, L<quarto(1)>

=head1 AUTHOR

liubianshi

=cut
